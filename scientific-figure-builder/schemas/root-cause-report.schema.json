{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scientific-figure-builder/schemas/root-cause-report.schema.json",
  "title": "Root Cause Analysis Report",
  "description": "Root cause analysis for validation failures (spec 0001, improvement 4).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "findings", "severity_ranking"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symptom", "likely_cause", "remediation"],
        "properties": {
          "symptom": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check_id", "detail"],
            "properties": {
              "check_id": { "type": "string", "minLength": 1 },
              "detail": { "type": "string" }
            }
          },
          "likely_cause": { "type": "string", "minLength": 1 },
          "remediation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "severity_ranking": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
