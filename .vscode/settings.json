{
    // 排除全局搜索的指定范围
    "search.exclude": {
        "**/.venv": true,
        "**/dist": true,
        "**/__pycache__": true
    },
    "files.exclude": {
        "**/.venv": true,
        "**/__pycache__": true
    },
    // 指向 uv sync 创建的 scientific-figure-builder/.venv。这里只声明目录，
    // 不写死 bin/python：Windows 上的解释器在 Scripts/python.exe，写死会让
    // 该平台贡献者拿到一个不存在的路径。
    "python.venvPath": "${workspaceFolder}/scientific-figure-builder",
    "python.analysis.exclude": ["**/.venv/**", "**/dist/**"],
    "python.analysis.userFileIndexingLimit": 5000
}
