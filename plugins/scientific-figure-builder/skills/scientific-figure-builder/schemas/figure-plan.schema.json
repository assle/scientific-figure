{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scientific-figure-builder/schemas/figure-plan.schema.json",
  "title": "Figure Plan",
  "description": "Versioned figure plan produced by the planning layer (plan section 7).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "figure_id",
    "run_id",
    "canvas",
    "units",
    "panels",
    "assets",
    "style_bible_ref",
    "text_elements",
    "assumptions",
    "uncertainties",
    "user_input_requirements",
    "estimated_paid_calls",
    "planned_uploads",
    "approval"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "plan_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "figure_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspect_ratio", "width", "height"],
      "properties": {
        "aspect_ratio": { "type": "number", "exclusiveMinimum": 0 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "units": { "type": "string", "enum": ["mm", "cm", "in", "px"] },
    "panels": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/panel" }
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/plannedAsset" }
    },
    "style_bible_ref": { "type": "string", "minLength": 1 },
    "text_elements": {
      "type": "array",
      "items": { "$ref": "#/$defs/textElement" }
    },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "uncertainties": { "type": "array", "items": { "type": "string" } },
    "user_input_requirements": { "type": "array", "items": { "type": "string" } },
    "estimated_paid_calls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_analysis", "generation", "edits", "validations", "final_validation"],
      "properties": {
        "reference_analysis": { "type": "integer", "minimum": 0 },
        "generation": { "type": "integer", "minimum": 0 },
        "edits": { "type": "integer", "minimum": 0 },
        "validations": { "type": "integer", "minimum": 0 },
        "final_validation": { "type": "integer", "minimum": 0 }
      }
    },
    "planned_uploads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "brief_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "content_hash"],
      "properties": {
        "artifact": {"type": "string", "minLength": 1},
        "content_hash": {"type": "string", "minLength": 1}
      }
    },
    "figure_graph_ref": {"$ref": "#/$defs/artifactRef"},
    "solved_layout_ref": {"$ref": "#/$defs/artifactRef"},
    "blueprint_ref": {"$ref": "#/$defs/artifactRef"},
    "structure_questions_ref": {"$ref": "#/$defs/artifactRef"},
    "generation_conditions_ref": {"$ref": "#/$defs/artifactRef"},
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "export_target": {"type": "string", "enum": ["general", "ppt"]},
        "figure_width_cm": {"type": "number", "exclusiveMinimum": 0},
        "include_pptx": {"type": "boolean"}
      }
    },
    "language": {"type": "string", "enum": ["zh", "en"]},
    "style": {"type": "string", "minLength": 1},
    "publication_profile": {"type": "string", "minLength": 1},
    "approval": { "$ref": "#/$defs/approval" }
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "content_hash"],
      "properties": {
        "artifact": {"type": "string", "minLength": 1},
        "content_hash": {"type": "string", "minLength": 1}
      }
    },
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["panel_id", "bbox", "physical_size"],
      "properties": {
        "panel_id": { "type": "string", "minLength": 1 },
        "bbox": { "$ref": "#/$defs/bbox" },
        "physical_size": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "plannedAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "type", "z_order", "dependencies", "routing"],
      "properties": {
        "asset_id": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["data_plot", "schematic", "image_asset", "vector_element", "text", "equation"]
        },
        "z_order": { "type": "integer" },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "routing": {
          "type": "string",
          "enum": ["python", "svg", "image_model", "pptx"]
        },
        "panel_id": {"type": "string", "minLength": 1},
        "bbox": {"$ref": "#/$defs/bbox"},
        "bbox_space": {"type": "string", "enum": ["canvas", "panel"]},
        "physical_size": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "number", "exclusiveMinimum": 0}
        },
        "source": {"type": "object"}
      }
    },
    "textElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["element_id", "kind", "content"],
      "properties": {
        "element_id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["label", "annotation", "equation"] },
        "content": { "type": "string", "minLength": 1 },
        "latex": { "type": "string" },
        "panel_id": {"type": "string", "minLength": 1}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected", "auto_execute"]
        },
        "approved_at": { "type": "string" }
      }
    }
  }
}
