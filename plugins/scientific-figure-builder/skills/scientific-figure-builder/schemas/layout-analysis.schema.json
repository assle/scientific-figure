{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scientific-figure-builder/schemas/layout-analysis.schema.json",
  "title": "Layout Analysis Report",
  "description": "Pre-render layout analysis output (spec 0001, improvement 2).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "panel_width_recommendations", "legend_placement_recommendations", "warnings"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "panel_width_recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["panel_id", "data_element_count", "recommended_ratio"],
        "properties": {
          "panel_id": { "type": "string", "minLength": 1 },
          "data_element_count": { "type": "integer", "minimum": 0 },
          "recommended_ratio": { "type": "number", "exclusiveMinimum": 0 },
          "reasoning": { "type": "string" }
        }
      }
    },
    "legend_placement_recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["panel_id", "candidates"],
        "properties": {
          "panel_id": { "type": "string", "minLength": 1 },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["position", "density_score"],
              "properties": {
                "position": {
                  "type": "string",
                  "enum": ["upper_left", "upper_right", "lower_left", "lower_right", "outside"]
                },
                "density_score": { "type": "number", "minimum": 0 },
                "is_recommended": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
